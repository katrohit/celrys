mesend.celrys.com {
  handle /ses/events {
    reverse_proxy millionsend:3001
  }

  handle {
    reverse_proxy millionsend:3000
  }
}

api.mesend.celrys.com {
  reverse_proxy millionsend:3001
}

# Link-tracking hosts: lm.gotixi.in (already-sent emails) and lm.in.gotixi.com (tracking domain for in.gotixi.com).
# Only click (/t/c/<token>), open-pixel (/t/o/<token>) and unsubscribe (/unsubscribe/<token>) paths reach the web app; everything else is a plain 404 so the host doesn't reveal MillionSend.
lm.gotixi.in, lm.in.gotixi.com {
  @tracking path_regexp ^/(t/[co]|unsubscribe(/confirm)?)/[^/]+$
  handle @tracking {
    reverse_proxy millionsend:3000
  }

  handle {
    respond 404
  }
}
